diff --git a/src/event/quic/ngx_event_quic_brutal.c b/src/event/quic/ngx_event_quic_brutal.c
new file mode 100644
index 0000000..e245c32
--- /dev/null
+++ b/src/event/quic/ngx_event_quic_brutal.c
@@ -0,0 +1,465 @@
+/*
+ * Copyright (C) Nginx, Inc.
+ */
+
+
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_event.h>
+#include <ngx_event_quic_connection.h>
+
+
+static void ngx_quic_brutal_pace_handler(ngx_event_t *ev);
+static uint64_t ngx_quic_brutal_rate(ngx_quic_congestion_t *cg);
+static uint64_t ngx_quic_brutal_burst(ngx_quic_congestion_t *cg, size_t mtu);
+static uint64_t ngx_quic_brutal_refill(ngx_quic_congestion_t *cg, size_t mtu);
+static void ngx_quic_brutal_update_ack_rate(ngx_quic_congestion_t *cg,
+    uint64_t acked, uint64_t nlost);
+
+
+void
+ngx_quic_brutal_init(ngx_connection_t *c, ngx_quic_connection_t *qc,
+    size_t bps)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_msec_t              now;
+
+    /*
+     * qc is passed explicitly: at ngx_quic_new_connection() time the
+     * back-pointer qsock->quic is not assigned yet, so
+     * ngx_quic_get_connection(c) would return NULL here.
+     */
+    cg = &qc->congestion;
+
+    ngx_log_debug2(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "quic brutal init enter bps:%uz enabled_before:%ui",
+                   bps, cg->brutal.enabled);
+
+    if (bps == 0) {
+        /* leave the struct zeroed: CUBIC path stays byte-identical */
+        return;
+    }
+
+    ngx_memzero(&cg->brutal, sizeof(ngx_quic_brutal_t));
+
+    cg->brutal.enabled = 1;
+    cg->brutal.bps = bps;
+    cg->brutal.ack_rate_milli = 1000;
+
+    now = ngx_current_msec;
+    cg->brutal.budget_msec = now;
+    cg->brutal.last_sent = now;
+
+    /*
+     * qc->path does not exist yet at this point: it is created later in
+     * ngx_quic_new_socket().  Use the conservative minimum size; the
+     * correct MTU is picked up once the first ACK recomputes the window.
+     */
+    cg->brutal.budget_mb = ngx_quic_brutal_burst(cg,
+                                  NGX_QUIC_MIN_INITIAL_SIZE) * 1000;
+
+    cg->brutal.pace.log = c->log;
+    cg->brutal.pace.data = c;
+    cg->brutal.pace.handler = ngx_quic_brutal_pace_handler;
+
+    /*
+     * Until a real RTT sample arrives avg_rtt is the RFC 9002 initial
+     * value of 333ms, which would make the window ~5x larger than any
+     * plausible link.  Seed with the CUBIC-ish initial window instead;
+     * the first ACK corrects it.
+     */
+    cg->window = ngx_min(10 * NGX_QUIC_MIN_INITIAL_SIZE,
+                         ngx_max(2 * NGX_QUIC_MIN_INITIAL_SIZE, 14720));
+    cg->ssthresh = (size_t) -1;
+    cg->mtu = NGX_QUIC_MIN_INITIAL_SIZE;
+
+    ngx_log_debug2(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "quic brutal init bps:%uz mtu:%uz", bps, cg->mtu);
+}
+
+
+/*
+ * Detach the pacing timer from the event loop.  Must be called before
+ * anything clears qc->congestion: the timer node is linked into the
+ * global rbtree (or the posted queue), and zeroing the owning struct
+ * without unlinking it leaves the tree holding a node with NULL links.
+ */
+void
+ngx_quic_brutal_cleanup(ngx_quic_connection_t *qc)
+{
+    ngx_quic_congestion_t  *cg;
+
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled) {
+        return;
+    }
+
+    if (cg->brutal.pace.timer_set) {
+        ngx_del_timer(&cg->brutal.pace);
+    }
+
+    if (cg->brutal.pace.posted) {
+        ngx_delete_posted_event(&cg->brutal.pace);
+    }
+}
+
+
+void
+ngx_quic_brutal_reset(ngx_connection_t *c, ngx_quic_connection_t *qc)
+{
+    /*
+     * Called right after a path change cleared the congestion struct,
+     * so only the derived state can be rebuilt here; the configured
+     * rate comes back from qc->conf, and ngx_quic_brutal_init()
+     * rewires the private event.  The caller is responsible for
+     * having run ngx_quic_brutal_cleanup() before the clear.
+     */
+    ngx_quic_brutal_init(c, qc, qc->conf->brutal_tx);
+}
+
+
+static void
+ngx_quic_brutal_pace_handler(ngx_event_t *ev)
+{
+    ngx_connection_t  *c;
+
+    ngx_log_debug0(NGX_LOG_DEBUG_EVENT, ev->log, 0, "quic brutal pace handler");
+
+    c = ev->data;
+
+    if (ngx_quic_output(c) != NGX_OK) {
+        ngx_quic_close_connection(c, NGX_ERROR);
+        return;
+    }
+
+    ngx_quic_connstate_dbg(c);
+}
+
+
+/*
+ * Send rate in bytes/sec: bps / ack_rate.  Losing packets makes this
+ * LARGER, compensating for the lost ones.  See brutal.go.
+ */
+static uint64_t
+ngx_quic_brutal_rate(ngx_quic_congestion_t *cg)
+{
+    if (cg->brutal.ack_rate_milli == 0) {
+        return cg->brutal.bps;
+    }
+
+    return (uint64_t) cg->brutal.bps * 1000 / cg->brutal.ack_rate_milli;
+}
+
+
+static uint64_t
+ngx_quic_brutal_burst(ngx_quic_congestion_t *cg, size_t mtu)
+{
+    uint64_t  rate, by_time, by_pkts;
+
+    rate = ngx_quic_brutal_rate(cg);
+
+    /* max(4ms of traffic, 10 datagrams), same as pacer.go maxBurstSize */
+    by_time = rate * NGX_QUIC_BRUTAL_BURST_MS / 1000;
+    by_pkts = (uint64_t) NGX_QUIC_BRUTAL_BURST_PKTS * mtu;
+
+    return ngx_max(by_time, by_pkts);
+}
+
+
+static uint64_t
+ngx_quic_brutal_refill(ngx_quic_congestion_t *cg, size_t mtu)
+{
+    ngx_msec_t  now;
+    uint64_t    cap;
+
+    now = ngx_current_msec;
+
+    cg->brutal.budget_mb += ngx_quic_brutal_rate(cg)
+                            * (uint64_t) (now - cg->brutal.budget_msec);
+
+    cg->brutal.budget_msec = now;
+
+    cap = ngx_quic_brutal_burst(cg, mtu) * 1000;
+
+    if (cg->brutal.budget_mb > cap) {
+        cg->brutal.budget_mb = cap;
+    }
+
+    return cg->brutal.budget_mb;
+}
+
+
+ngx_uint_t
+ngx_quic_brutal_has_budget(ngx_connection_t *c, size_t need)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_quic_connection_t  *qc;
+
+    qc = ngx_quic_get_connection(c);
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled) {
+        return 1;
+    }
+
+    ngx_quic_brutal_refill(cg, qc->path->mtu);
+
+    return cg->brutal.budget_mb / 1000 >= need;
+}
+
+
+void
+ngx_quic_brutal_on_sent(ngx_connection_t *c, size_t bytes)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_quic_connection_t  *qc;
+    uint64_t                cost;
+
+    qc = ngx_quic_get_connection(c);
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled) {
+        return;
+    }
+
+    ngx_quic_brutal_refill(cg, qc->path->mtu);
+
+    cost = (uint64_t) bytes * 1000;
+
+    cg->brutal.budget_mb = (cg->brutal.budget_mb >= cost)
+                           ? cg->brutal.budget_mb - cost : 0;
+
+    cg->brutal.last_sent = ngx_current_msec;
+}
+
+
+void
+ngx_quic_brutal_pace_arm(ngx_connection_t *c)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_quic_connection_t  *qc;
+    ngx_msec_t              delay;
+    uint64_t                rate, need, deficit;
+
+    qc = ngx_quic_get_connection(c);
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled || qc->closing) {
+        return;
+    }
+
+    /*
+     * Only arm when the budget is what is holding us back.  If we are
+     * window-blocked we must wait for ACKs, which already post push;
+     * arming here would spin a 1ms timer doing nothing.
+     */
+    if (cg->in_flight >= cg->window) {
+        return;
+    }
+
+    ngx_quic_brutal_refill(cg, qc->path->mtu);
+
+    need = (uint64_t) qc->path->mtu * 1000;
+
+    if (cg->brutal.budget_mb >= need) {
+        return;
+    }
+
+    rate = ngx_quic_brutal_rate(cg);
+
+    if (rate == 0) {
+        return;
+    }
+
+    deficit = need - cg->brutal.budget_mb;
+
+    /* ceil to whole milliseconds */
+    delay = (ngx_msec_t) ((deficit + rate - 1) / rate);
+
+    if (delay < NGX_QUIC_BRUTAL_PACE_QUANTUM) {
+        delay = NGX_QUIC_BRUTAL_PACE_QUANTUM;
+    }
+
+    ngx_log_debug2(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "quic brutal pace arm d:%M budget:%uL", delay,
+                   cg->brutal.budget_mb);
+
+    /*
+     * Always del before add: ngx_add_timer() keeps the old key when the
+     * new one is within NGX_TIMER_LAZY_DELAY of it.
+     */
+    if (cg->brutal.pace.timer_set) {
+        ngx_del_timer(&cg->brutal.pace);
+    }
+
+    ngx_add_timer(&cg->brutal.pace, delay);
+}
+
+
+void
+ngx_quic_brutal_update_window(ngx_connection_t *c)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_quic_connection_t  *qc;
+    uint64_t                cwnd, rate;
+    size_t                  floor;
+
+    qc = ngx_quic_get_connection(c);
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled) {
+        return;
+    }
+
+    floor = 2 * qc->path->mtu;
+
+    if (qc->first_rtt == NGX_TIMER_INFINITE) {
+        /* no sample yet, keep the conservative seed from init() */
+        cwnd = ngx_min(10 * NGX_QUIC_MIN_INITIAL_SIZE,
+                       ngx_max(2 * NGX_QUIC_MIN_INITIAL_SIZE, 14720));
+
+    } else {
+        rate = ngx_quic_brutal_rate(cg);
+
+        /*
+         * cwnd = bps * srtt * 2 / ack_rate.  Algebraically
+         * bps * (srtt_ms / 1000) * 2 / (ack_milli / 1000)
+         * == bps * srtt_ms * 2 / ack_milli, so ack_rate drops out of
+         * the divisor and this becomes rate-based, matching the pacer.
+         */
+        cwnd = rate * (uint64_t) qc->avg_rtt * NGX_QUIC_BRUTAL_CWND_MULT
+               / 1000;
+    }
+
+    if (cwnd < floor) {
+        cwnd = floor;
+    }
+
+    cg->mtu = qc->path->mtu;
+    cg->window = (size_t) ngx_min(cwnd, (uint64_t) NGX_MAX_SIZE_T_VALUE);
+    cg->ssthresh = (size_t) -1;
+
+    ngx_log_debug4(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "quic brutal window srtt:%M ack:%ui cwnd:%uz rate:%uL",
+                   qc->avg_rtt, cg->brutal.ack_rate_milli, cg->window,
+                   ngx_quic_brutal_rate(cg));
+}
+
+
+static void
+ngx_quic_brutal_update_ack_rate(ngx_quic_congestion_t *cg, uint64_t acked,
+    uint64_t nlost)
+{
+    time_t    sec, lo;
+    ngx_uint_t i, slot;
+    uint64_t  ta, tl, total;
+
+    sec = ngx_time();
+    slot = (ngx_uint_t) (sec % NGX_QUIC_BRUTAL_SLOTS);
+
+    if (cg->brutal.slot_sec[slot] == sec) {
+        cg->brutal.slot_ack[slot] += acked;
+        cg->brutal.slot_lost[slot] += nlost;
+
+    } else {
+        /* uninitialized slot or too old, reset */
+        cg->brutal.slot_sec[slot] = sec;
+        cg->brutal.slot_ack[slot] = acked;
+        cg->brutal.slot_lost[slot] = nlost;
+    }
+
+    lo = sec - NGX_QUIC_BRUTAL_SLOTS;
+
+    ta = 0;
+    tl = 0;
+
+    for (i = 0; i < NGX_QUIC_BRUTAL_SLOTS; i++) {
+        if (cg->brutal.slot_sec[i] < lo) {
+            continue;
+        }
+
+        ta += cg->brutal.slot_ack[i];
+        tl += cg->brutal.slot_lost[i];
+    }
+
+    total = ta + tl;
+
+    if (total < NGX_QUIC_BRUTAL_MIN_SAMPLES) {
+        cg->brutal.ack_rate_milli = 1000;
+        return;
+    }
+
+    cg->brutal.ack_rate_milli = (ngx_uint_t) (1000 * ta / total);
+
+    if (cg->brutal.ack_rate_milli < NGX_QUIC_BRUTAL_MIN_ACK_RATE) {
+        cg->brutal.ack_rate_milli = NGX_QUIC_BRUTAL_MIN_ACK_RATE;
+    }
+}
+
+
+void
+ngx_quic_brutal_on_ack_event(ngx_connection_t *c, uint64_t acked,
+    uint64_t nlost)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_quic_connection_t  *qc;
+    ngx_msec_t              now;
+
+    qc = ngx_quic_get_connection(c);
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled) {
+        return;
+    }
+
+    now = ngx_current_msec;
+
+    /*
+     * A real idle gap invalidates the loss history: the losses we saw
+     * before the stall say nothing about the path now.  Note this uses
+     * wall clock, not cg->idle, which only means "send queue empty" and
+     * is set by revert_send() on every NGX_AGAIN.
+     */
+    if (now - cg->brutal.last_sent > NGX_QUIC_BRUTAL_IDLE_RESET) {
+        ngx_memzero(cg->brutal.slot_sec, sizeof(cg->brutal.slot_sec));
+        ngx_memzero(cg->brutal.slot_ack, sizeof(cg->brutal.slot_ack));
+        ngx_memzero(cg->brutal.slot_lost, sizeof(cg->brutal.slot_lost));
+        cg->brutal.ack_rate_milli = 1000;
+    }
+
+    ngx_quic_brutal_update_ack_rate(cg, acked, nlost);
+    ngx_quic_brutal_update_window(c);
+
+    ngx_log_debug4(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "quic brutal ackev acked:%uL lost:%uL rate:%ui win:%uz",
+                   acked, nlost, cg->brutal.ack_rate_milli, cg->window);
+
+    /* the window may have grown: resume sending if we were blocked */
+    if (cg->in_flight < cg->window && !qc->push.posted && !qc->closing) {
+        ngx_post_event(&qc->push, &ngx_posted_events);
+    }
+}
+
+
+void
+ngx_quic_brutal_on_idle(ngx_connection_t *c, ngx_uint_t idle)
+{
+    ngx_quic_congestion_t  *cg;
+    ngx_quic_connection_t  *qc;
+
+    qc = ngx_quic_get_connection(c);
+    cg = &qc->congestion;
+
+    if (!cg->brutal.enabled) {
+        return;
+    }
+
+    /*
+     * Nothing to do.  CUBIC's RFC 9438 5.8 bookkeeping rewrites k and
+     * idle_start; in Brutal the window is recomputed from srtt on every
+     * ACK, so there is no accumulation to correct.  The flag itself is
+     * written by the caller.
+     */
+    (void) idle;
+}
diff --git a/src/event/quic/ngx_event_quic_brutal.h b/src/event/quic/ngx_event_quic_brutal.h
new file mode 100644
index 0000000..5cdc24c
--- /dev/null
+++ b/src/event/quic/ngx_event_quic_brutal.h
@@ -0,0 +1,88 @@
+/*
+ * Copyright (C) Nginx, Inc.
+ */
+
+
+#ifndef _NGX_EVENT_QUIC_BRUTAL_H_INCLUDED_
+#define _NGX_EVENT_QUIC_BRUTAL_H_INCLUDED_
+
+
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_event.h>
+
+
+/*
+ * Brutal congestion control, ported from hysteria2.
+ *
+ * Design: the sender declares its own bandwidth and ignores loss.
+ *
+ *     cwnd = brutaltx * srtt * 2 / ack_rate
+ *     pace = brutaltx / ack_rate
+ *
+ * ack_rate is the ack/(ack+loss) ratio over a 5 second sliding window,
+ * clamped to [0.8, 1.0].  A lower ack_rate means a HIGHER send rate: this
+ * is loss compensation, not backoff.  Losses never shrink the window.
+ *
+ * Costs: this is only as good as the configured rate.  Overshooting
+ * builds a standing queue at the bottleneck (bufferbloat) and, because
+ * nothing backs off, does not self-correct.  Read the rate as the safe
+ * rate, not the peak rate.
+ */
+
+#define NGX_QUIC_BRUTAL_SLOTS          5    /* 5 x 1s window */
+#define NGX_QUIC_BRUTAL_MIN_SAMPLES    50
+#define NGX_QUIC_BRUTAL_MIN_ACK_RATE   800  /* 0.800, milli-units */
+#define NGX_QUIC_BRUTAL_CWND_MULT      2
+#define NGX_QUIC_BRUTAL_BURST_PKTS     10
+#define NGX_QUIC_BRUTAL_BURST_MS       4    /* 4 * MinPacingDelay(1ms) */
+#define NGX_QUIC_BRUTAL_IDLE_RESET     2000 /* ms; clear loss history */
+#define NGX_QUIC_BRUTAL_PACE_QUANTUM   1    /* ms; minimum timer granularity */
+
+
+typedef struct {
+    ngx_uint_t      enabled;            /* set once, at connection setup */
+    ngx_uint_t      ack_rate_milli;     /* 800..1000 */
+    size_t          bps;                /* bytes/sec, copied from conf */
+
+    /* 5 second sliding window, slot index is based on seconds */
+    time_t          slot_sec[NGX_QUIC_BRUTAL_SLOTS];
+    uint64_t        slot_ack[NGX_QUIC_BRUTAL_SLOTS];
+    uint64_t        slot_lost[NGX_QUIC_BRUTAL_SLOTS];
+
+    /* token bucket, bytes*1000 to keep millisecond resolution exact */
+    uint64_t        budget_mb;
+    ngx_msec_t      budget_msec;
+    ngx_msec_t      last_sent;
+
+    /*
+     * Private pacing timer.  Deliberately not qc->push: ngx_add_timer()
+     * ignores a new timer whose key is within NGX_TIMER_LAZY_DELAY
+     * (300ms) of the armed one, so a 2ms pacing request would be
+     * silently stretched to whatever the pending push timer holds.
+     *
+     * This member lives inside ngx_quic_congestion_t, which
+     * ngx_quic_handle_path_response_frame() clears with ngx_memzero()
+     * on a path change.  Every caller that does so MUST call
+     * ngx_quic_brutal_cleanup() first: a timer that is still linked
+     * into the global rbtree but has its links zeroed corrupts the
+     * tree, and ngx_event_expire_timers() then dereferences NULL.
+     */
+    ngx_event_t     pace;
+} ngx_quic_brutal_t;
+
+
+void ngx_quic_brutal_init(ngx_connection_t *c, ngx_quic_connection_t *qc,
+    size_t bps);
+void ngx_quic_brutal_cleanup(ngx_quic_connection_t *qc);
+void ngx_quic_brutal_reset(ngx_connection_t *c, ngx_quic_connection_t *qc);
+void ngx_quic_brutal_on_ack_event(ngx_connection_t *c, uint64_t acked,
+    uint64_t nlost);
+void ngx_quic_brutal_on_idle(ngx_connection_t *c, ngx_uint_t idle);
+ngx_uint_t ngx_quic_brutal_has_budget(ngx_connection_t *c, size_t need);
+void ngx_quic_brutal_on_sent(ngx_connection_t *c, size_t bytes);
+void ngx_quic_brutal_pace_arm(ngx_connection_t *c);
+void ngx_quic_brutal_update_window(ngx_connection_t *c);
+
+
+#endif /* _NGX_EVENT_QUIC_BRUTAL_H_INCLUDED_ */
